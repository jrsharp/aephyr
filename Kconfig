config NET_L2_CUSTOM
	bool "Enable custom Layer 2 protocol support"
	depends on NETWORKING
	help
	  Enable support for custom Layer 2 protocols.
	  This allows implementing custom MAC protocols that don't fit
	  the standard Ethernet/IEEE 802.11/etc. model.

if NET_L2_CUSTOM

config NET_L2_HEYMAC
	bool "HeyMac Layer 2 protocol support"
	depends on NET_L2_CUSTOM
	help
	  Enable HeyMac Layer 2 protocol for mesh networking.
	  HeyMac provides the MAC layer for Æther mesh networks. It is
	  radio-agnostic; the concrete radio is provided by a driver
	  integration (AETHER_LORA for SX126x, AETHER_DECT for DECT NR+).

if NET_L2_HEYMAC

config NET_L2_HEYMAC_LOG_LEVEL
	int "HeyMac log level"
	depends on LOG
	default 3
	range 0 4
	help
	  Set log level for HeyMac protocol.

config HEYMAC_DEFAULT_NET_ID
	hex "Default HeyMac network ID"
	default 0x915E
	help
	  Default network ID for HeyMac frames.
	  0x915E = "915E" for 915MHz networks.

config HEYMAC_USE_SHORT_ADDR
	bool "Use short addressing by default"
	default y
	help
	  Use 2-byte short addresses instead of 6-byte long addresses.

config HEYMAC_MAX_FRAME_SIZE
	int "Maximum frame size"
	default 255
	range 64 255
	help
	  Maximum HeyMac frame size in bytes.

endif # NET_L2_HEYMAC

config HEYMAC_BEACON_INTERVAL_MS
	int "Beacon interval (milliseconds)"
	depends on NET_L2_HEYMAC
	default 30000
	range 5000 120000
	help
	  Interval between beacon transmissions in milliseconds.

rsource "subsys/net/l2/uart/Kconfig"

config AETHER_MESH
	bool "Æther mesh networking support"
	depends on NET_L2_HEYMAC || AETHER_UART
	help
	  Enable Æther mesh networking protocol for multi-hop networks.
	  Works over HeyMac (LoRa) or UART transports.

if AETHER_MESH

config AETHER_MESH_LOG_LEVEL
	int "Æther mesh log level"
	depends on LOG
	default 3
	range 0 4
	help
	  Set log level for Æther mesh protocol.

config AETHER_MAX_ROUTES
	int "Maximum number of routes in routing table"
	default 16
	range 4 64
	help
	  Maximum number of destination routes to maintain.

config AETHER_MAX_NEIGHBORS
	int "Maximum number of neighbors"
	default 8
	range 4 32
	help
	  Maximum number of direct neighbors to track.

config AETHER_DEFAULT_TTL
	int "Default time-to-live for mesh packets"
	default 6
	range 1 15
	help
	  Default TTL value for originated packets.

config AETHER_HELLO_INTERVAL
	int "Hello message interval (seconds)"
	default 30
	range 10 300
	help
	  Interval between hello messages for neighbor discovery.

config AETHER_ROUTE_TIMEOUT
	int "Route timeout (seconds)"
	default 300
	range 60 3600
	help
	  Time before inactive routes are expired.

config AETHER_NEIGHBOR_TIMEOUT
	int "Neighbor timeout (seconds)"
	default 90
	range 30 600
	help
	  Time before inactive neighbors are considered lost.

config AETHER_CONDITIONAL_NET_ID
	bool "Use conditional mesh network ID optimization"
	default y
	help
	  Enable conditional mesh network ID to save 2 bytes when mesh
	  network ID matches MAC network ID (12.5% header reduction).

config AETHER_MAX_PAYLOAD
	int "Maximum payload size"
	default 200
	range 32 255
	help
	  Maximum payload size for mesh packets. SX1262 supports up to
	  255 bytes per LoRa packet. Larger payloads reduce fragmentation
	  overhead for 9P transport.

config AETHER_SHELL
	bool "Æther shell commands"
	depends on SHELL
	help
	  Enable shell commands for Æther mesh debugging and control.

endif # AETHER_MESH

config AETHER_LORA
	bool "Æther LoRa driver integration"
	depends on LORA_SX126X
	depends on NET_L2_HEYMAC
	help
	  LoRa driver integration for Æther mesh networking.

if AETHER_LORA

config AETHER_LORA_LOG_LEVEL
	int "Æther LoRa log level"
	depends on LOG
	default 3
	range 0 4

config AETHER_RX_QUEUE_SIZE
	int "RX message queue size"
	default 8
	range 4 32
	help
	  Number of messages that can be queued for RX processing.

config AETHER_TX_QUEUE_SIZE
	int "TX message queue size"
	default 4
	range 2 16
	help
	  Number of messages that can be queued for transmission.

config AETHER_RX_STACK_SIZE
	int "RX thread stack size"
	default 2048 if !SOC_ESP32
	default 3072 if SOC_ESP32
	range 1024 8192
	help
	  Stack size for the RX processing thread.

config AETHER_TX_STACK_SIZE
	int "TX thread stack size"
	default 1536 if !SOC_ESP32
	default 2048 if SOC_ESP32
	range 1024 8192
	help
	  Stack size for the TX processing thread.

config AETHER_RX_THREAD_PRIO
	int "RX thread priority"
	default 2
	range 0 16
	help
	  Priority for the RX processing thread.

config AETHER_TX_THREAD_PRIO
	int "TX thread priority"
	default 3
	range 0 16
	help
	  Priority for the TX processing thread.

config AETHER_LORA_SF
	int "Default spreading factor"
	default 7
	range 7 12
	help
	  Default LoRa spreading factor (SF7-SF12).

config AETHER_LORA_BW
	int "Default bandwidth"
	default 0
	range 0 2
	help
	  Default LoRa bandwidth (0=125kHz, 1=250kHz, 2=500kHz).

config AETHER_LORA_CR
	int "Default coding rate"
	default 1
	range 1 4
	help
	  Default LoRa coding rate (1=4/5, 2=4/6, 3=4/7, 4=4/8).

config AETHER_LORA_TX_POWER
	int "Default TX power (dBm)"
	default 14
	range 0 22
	help
	  Default transmit power in dBm.

config AETHER_LORA_CAD_ENABLED
	bool "Enable CAD listen-before-talk"
	default y
	help
	  Enable Channel Activity Detection (CAD) before each transmission.
	  The SX1262 hardware detects LoRa preambles in ~16ms. If the channel
	  is busy, the driver backs off and retries before transmitting.

config AETHER_LORA_CAD_MAX_RETRIES
	int "Maximum CAD retry attempts"
	depends on AETHER_LORA_CAD_ENABLED
	default 5
	range 1 10
	help
	  Number of times to retry CAD if the channel is busy before
	  transmitting anyway.

config AETHER_LORA_CAD_BACKOFF_MAX_MS
	int "Maximum CAD backoff (ms)"
	depends on AETHER_LORA_CAD_ENABLED
	default 100
	range 20 500
	help
	  Maximum random backoff time in milliseconds when CAD detects
	  channel activity.

endif # AETHER_LORA

config AETHER_DECT
	bool "Æther DECT NR+ driver integration"
	depends on NET_L2_HEYMAC
	depends on NRF_MODEM_LIB
	help
	  DECT NR+ PHY driver integration for Æther mesh networking on the
	  nRF91 Series (nRF9151/nRF9161, e.g. nRF9151 DK, Thingy:91 X).
	  Provides a HeyMac radio backed by the DECT NR+ physical layer with
	  listen-before-talk channel access. Requires the DECT NR+ PHY modem
	  firmware. Mutually exclusive with AETHER_LORA.

if AETHER_DECT

config AETHER_DECT_LOG_LEVEL
	int "Æther DECT log level"
	depends on LOG
	default 3
	range 0 4

config AETHER_DECT_CARRIER
	int "DECT NR+ carrier (channel) number"
	default 0
	help
	  Absolute channel frequency number. Availability and the rules for
	  using a channel vary by country and region (see ETSI TS 103 636-2
	  section 5.4.2). A value of 0 fails the build on purpose: set the
	  carrier deliberately for your region (1677 is a common EU value,
	  1711 a common US value).

config AETHER_DECT_NETWORK_ID
	int "DECT NR+ network ID"
	range 1 4294967295
	default 91
	help
	  PHY-layer network identifier shared by all nodes. Distinct from the
	  logical HeyMac/Æther network ID carried in the frame.

config AETHER_DECT_MCS
	int "Modulation and coding scheme (MCS) index"
	range 0 4
	default 1
	help
	  Higher MCS carries more bytes per subslot at the cost of range.

config AETHER_DECT_PACKET_LENGTH
	int "PHY packet length in subslots"
	range 1 16
	default 2
	help
	  Number of subslots reserved per transmitted frame. Must be large
	  enough to carry the payload at the configured MCS.
	  TODO: derive this from the frame length using the DECT transport
	  block size tables instead of a fixed value. Small frames (beacons,
	  hellos) fit the default; large data/9P frames need a larger value.

config AETHER_DECT_TX_POWER
	int "Transmit power index"
	range 0 13
	default 11
	help
	  DECT NR+ transmit power setting (see ETSI TS 103 636-4 table
	  6.2.1-3). Lower values reduce interference between bench nodes.

config AETHER_DECT_RX_WINDOW_MS
	int "Receive window duration in milliseconds"
	range 10 2000
	default 200
	help
	  Duration of each continuous receive window between transmit bursts.
	  Bounds worst-case transmit latency in the windowed-RX model.

config AETHER_DECT_LBT_ENABLED
	bool "Listen-before-talk (CSMA) on transmit"
	default y
	help
	  Perform energy-based listen-before-talk inside each transmit
	  operation. If the channel is busy the transmission is not sent and
	  the driver backs off and retries (CSMA).

config AETHER_DECT_LBT_THRESHOLD_DBM
	int "Listen-before-talk RSSI threshold in dBm"
	depends on AETHER_DECT_LBT_ENABLED
	range -140 -1
	default -70
	help
	  Channel is considered busy when measured RSSI exceeds this level.

config AETHER_DECT_CAD_MAX_RETRIES
	int "Maximum channel-busy retry attempts"
	default 5
	range 1 10
	help
	  Number of times to back off and retry when listen-before-talk
	  reports the channel busy before giving up on a frame.

config AETHER_DECT_CAD_BACKOFF_MAX_MS
	int "Maximum channel-busy backoff in milliseconds"
	default 100
	range 5 500
	help
	  Maximum random backoff between retries when the channel is busy.

config AETHER_DECT_RX_QUEUE_SIZE
	int "RX message queue size in frames"
	default 8
	range 4 32

config AETHER_DECT_TX_QUEUE_SIZE
	int "TX message queue size in frames"
	default 4
	range 2 16

config AETHER_DECT_RX_STACK_SIZE
	int "RX thread stack size in bytes"
	default 2048
	range 1024 8192

config AETHER_DECT_TX_STACK_SIZE
	int "Radio thread stack size in bytes"
	default 2048
	range 1024 8192

config AETHER_DECT_RX_THREAD_PRIO
	int "RX thread priority"
	default 2
	range 0 16

config AETHER_DECT_TX_THREAD_PRIO
	int "Radio thread priority"
	default 3
	range 0 16

endif # AETHER_DECT

endif # NET_L2_CUSTOM