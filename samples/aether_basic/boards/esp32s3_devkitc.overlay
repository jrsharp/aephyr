/ {
	chosen {
		zephyr,lora = &sx1262;
	};
};

/* Configure SPI2 with ESP32-S3 GPIO matrix */
&spi2 {
	status = "okay";
	
	/* ESP32-S3 typical SPI pins - adjust to match your wiring */
	pinctrl-0 = <&spi2_miso_gpio13 &spi2_mosi_gpio11 
		     &spi2_sclk_gpio12 &spi2_cs_gpio10>;
	pinctrl-names = "default";
	
	/* Attach the SX1262 to this SPI bus */
	#address-cells = <1>;
	#size-cells = <0>;
	
	sx1262: sx1262@0 {
		compatible = "semtech,sx1262";
		status = "okay";
		spi-max-frequency = <16000000>;
		reg = <0>;
		
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
		
		power-amplifier-output = "pa-boost";
	};
};